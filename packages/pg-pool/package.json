{
  "name": "@stackline/pg-pool",
  "version": "1.0.0",
  "description": "Dependency-clean connection pool compatible with pg-pool 3.14.0",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./esm/index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test:upstream": "node test/run.js",
    "test:contract": "node --test test/stackline-contract.test.js",
    "test:smoke": "node scripts/smoke-install.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test": "npm run test:upstream && npm run test:contract",
    "verify": "npm test && npm run check:package && npm run test:smoke && npm run pack:check",
    "artifact:prepare": "node scripts/create-artifact.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-pg.git",
    "directory": "packages/pg-pool"
  },
  "keywords": [
    "pg",
    "postgres",
    "pool",
    "database"
  ],
  "author": "Stackline Maintainers",
  "contributors": [
    "Brian M. Carlson"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-pg/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/pg-pool/",
  "peerDependencies": {
    "pg": ">=8.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "esm",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "DEPENDENCY_REVIEW.md",
    "LICENSE",
    "MIGRATION.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
