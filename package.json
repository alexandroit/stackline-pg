{
  "name": "@stackline/pg",
  "version": "1.0.3",
  "description": "Maintained, dependency-reviewed PostgreSQL client compatible with pg 8.23.0",
  "type": "commonjs",
  "main": "./lib",
  "exports": {
    ".": {
      "import": "./esm/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./lib/*": "./lib/*.js",
    "./lib/*.js": "./lib/*.js"
  },
  "dependencies": {
    "pg-connection-string": "2.14.0",
    "pg-pool": "npm:@stackline/pg-pool@1.0.0",
    "pg-protocol": "1.16.0",
    "pg-types": "npm:@stackline/pg-types@1.0.0",
    "pgpass": "1.0.6"
  },
  "optionalDependencies": {
    "pg-cloudflare": "1.4.0"
  },
  "devDependencies": {
    "pg-copy-streams": "npm:@stackline/pg-copy-streams@1.0.0"
  },
  "scripts": {
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:contract": "node scripts/contract-tests.mjs",
    "test:smoke": "node scripts/smoke-install.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:security-contract",
    "verify": "npm test && npm run check:package && npm run test:smoke && npm run pack:check",
    "artifact:prepare": "node scripts/create-artifact.mjs",
    "test:security-contract": "node scripts/security-contract-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-pg.git"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "pg",
    "nodejs",
    "database",
    "node-postgres",
    "postgres",
    "postgresql",
    "sql"
  ],
  "author": "Stackline Maintainers",
  "contributors": [
    "Brian M. Carlson"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-pg/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/pg/",
  "files": [
    "lib",
    "esm",
    "SPONSORS.md",
    "UPSTREAM_README.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "DEPENDENCY_REVIEW.md",
    "LICENSE",
    "MIGRATION.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md",
    "DEPENDENCY_UPDATES.md",
    "CODEQL_REVIEW.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
